# Lifecycle trace for one ticket, happy path first, then the practical breakdowns.
# Conventions (same as 06-ownership.d2, plus):
#   - shape: sequence_diagram; actors declared first, in the order they are read
#   - one group per lifecycle stage, numbered; breakdown groups prefixed "W"
#   - a message label names the exact command or API call; a quoted note names a rule
#   - class drift marks messages that end in an error row instead of a write

shape: sequence_diagram

classes: {
  drift: {
    style: {
      stroke: "#b00020"
      font-color: "#b00020"
    }
  }
  rule: {
    style: {
      fill: "#fff3cd"
    }
  }
}

you: You {
  shape: person
}
todoist: Todoist
dev: dev
file: docs/tickets/<slug>.toml
github: github issue

s1: 1 capture (any surface) {
  you -> todoist: add task "slug" in the repo project, label ?stub or ?seed
  todoist."dev ignores it: no file exists yet" {
    class: rule
  }
}

s2: 2 define {
  you -> dev: dev new <slug>
  dev -> file: write draft (version, slug, date, status = draft, empty body)
  dev."seed: dev migrate <slug>, or dev new <slug> --prompt --files <issue.md>" {
    class: rule
  }
}

s3: 3 link (first dev sync) {
  you -> dev: dev sync <slug>
  dev -> file: read
  dev -> todoist: find content = slug in the mapped project (open, then completed)
  alt-found: found {
    dev -> file: "write reference.todoist {id url}"
  }
  alt-missing: missing {
    dev -> todoist: todo add "slug" --project <mapped> --label (%deliverable if output non-empty else %actionable)
    dev -> file: "write reference.todoist {id url}"
  }
  dev -> todoist: list direct subtasks of id
  dev -> file: "replace [[tasks]] wholesale"
  dev."status = draft: the github leg is skipped" {
    class: rule
  }
}

s4: 4 open {
  you -> dev: "dev edit <slug> --set {status: open, target: v0.4.0}"
  you -> dev: dev sync <slug>
  dev -> todoist: find version target "<repo>@v0.4.0" in the parent project
  dev -> github: ensure milestone "v0.4.0" (state from checked, due from due)
  dev -> github: create issue, title = slug, body = dev <slug> --md (checklist from rows, notes verbatim), milestone = v0.4.0
  dev -> file: "write reference.github {index url branch = slug}"
  dev -> todoist: set task description = markdown link to the issue
  dev -> todoist: "rewrite the first line of the version target's description: -> <repo>#N ..."
  dev."target set but no <repo>@<version> task in Todoist: error row, add it there first" {
    class: rule
  }
}

s5: 5 work {
  you -> todoist: (phone) add subtask "write failing test"
  you -> dev: "dev edit <slug> --add-task {content: ...}"
  dev -> todoist: todo add --parent id:<id>
  you -> dev: dev edit <slug> --complete "write failing test"
  dev -> todoist: find subtask by content under id, todo done id:<sub>
  dev -> todoist: list direct subtasks
  dev -> file: "replace [[tasks]]"
  you -> dev: dev sync <slug>
  dev -> github: update body (checklist reflects checked rows)
  file."git switch -c <slug>: the track hook resolves the branch to the task" {
    class: rule
  }
}

s6: 6 close {
  you -> todoist: check the ticket task (phone)
  you -> dev: dev sync <slug>
  dev -> todoist: view id, checked = true
  dev -> file: status = done
  dev -> github: close issue, reason completed
  abort: abort instead {
    you -> dev: "dev edit <slug> --set {status: aborted}"
    dev -> github: close issue, reason not planned
    dev -> todoist: complete the task
  }
}

w1: W1 renamed in Todoist {
  you -> todoist: (phone) rename content to "slug-v2"
  you -> dev: dev sync <slug>
  dev -> todoist: view id, content != slug
  dev -> you: error row, content drifted, nothing written {
    class: drift
  }
}

w2: W2 pruned in Todoist {
  you -> todoist: delete the task (biweekly prune chore)
  you -> dev: dev sync <slug>
  dev -> todoist: view id, not found
  dev -> you: error row, task gone, set aborted or clear the reference {
    class: drift
  }
  dev."decision: report only, or auto-abort" {
    class: rule
  }
}

w3: W3 closed on github first {
  you -> github: merge PR with "closes #N"
  you -> dev: dev sync <slug>
  dev -> github: issue closed, todoist unchecked
  dev -> todoist: complete the task
  dev -> file: status = done
  dev."proposal: closure is accepted from any surface, reopening only from Todoist" {
    class: rule
  }
}

w5: W5 version target renamed or released early {
  you -> todoist: (phone) rename "nu-fluency@v0.4.0" to "nu-fluency@v0.4.1"
  you -> dev: dev sync <slug>
  dev -> todoist: no task matches target v0.4.0
  dev -> you: error row, target has no version task, nothing written {
    class: drift
  }
  you -> todoist: check "nu-fluency@v0.4.0" while member tickets are open
  you -> dev: dev sync --all
  dev -> github: close milestone v0.4.0, open issues stay assigned
  dev."mirrors Todoist: a closed milestone with open issues is allowed on both sides" {
    class: rule
  }
}

w4: W4 half a sync {
  you -> dev: dev sync <slug>
  dev -> todoist: ensure task, pull rows (ok)
  dev -> github: create issue (auth fails)
  dev -> you: result row names the failed leg and next command {
    class: drift
  }
  you -> dev: dev sync <slug> again
  dev -> todoist: ensure steps find nothing to do
  dev -> github: create issue (ok)
}
